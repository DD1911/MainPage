
/**
 * Klasse 01_Variablen_Konstanten_Kommentare
 * 
 * Einführung:
 * - Wie man Kommentare schreibt (einzeilig, mehrzeilig, JavaDoc)
 * - Deklaration und Initialisierung von Variablen
 * - Konstanten definieren
 * - Namenskonventionen für Variablen und Konstanten
 * - Trennzeichen für Zahlen
 */

public class _01_Variablen_Konstanten_Kommentare {

    public static void main(String[] args){

        System.out.println("So erstellt man einen Kommentar");

        // === 1. Kommentare ===
        // Einzeiliger Kommentar: wird nur in dieser Zeile ausgeführt

        /*
         * Mehrzeiliger Kommentar:
         * Kann über mehrere Zeilen gehen
         * Gut für ausführliche Erklärungen
         */

        /**
         * JavaDoc-Kommentar:
         * Wird für automatische Dokumentationen verwendet
         * Beginnt mit /** und endet mit */
         */

        System.out.println("Kommentare sind wichtig für die Lesbarkeit!");

        // === 2. Variablen ===
        // Variablen speichern Daten während der Programmausführung

        // Deklaration einer Variable (nur Typ + Name)
        int eineZahl;                
        eineZahl = 20;               // Initialisierung: Wert zuweisen

        // Deklaration + Initialisierung in einer Zeile
        int eineZahl2 = 15;

        // Mehrfach-Deklaration derselben Art
        int zahl3, zahl4, zahl5;     // alle int

        // === 3. Konstanten ===
        // Konstanten sind unveränderliche Werte, werden mit final deklariert
        // Namenskonvention: SCREAMING_SNAKE_CASE
        final int MAX_WERT = 100;

        // Versuch, eine Konstante zu ändern, führt zu Fehler:
        // MAX_WERT = 200;  // ❌ Kompilerfehler

        // === 4. Namenskonventionen für Variablen ===
        // LowerCamelCase:
        int meinAlter = 25;
        String aktuellesWetter = "Sonnig";

        // Variablen dürfen nicht mit Zahlen oder Sonderzeichen beginnen
        // z.B. int 1Zahl; ❌ ist falsch
        // int _ersteZahl; ✅ korrekt
        // int $preis; ✅ korrekt

        // Java-Schlüsselwörter dürfen nicht verwendet werden
        // z.B. int class; ❌

        // === 5. Trennsymbol für Zahlen ===
        // Erleichtert die Lesbarkeit großer Zahlen
        int grosseZahl = 200_000;    // 200000, das Unterstrichsymbol dient nur der Lesbarkeit

        System.out.println("Variable eineZahl: " + eineZahl);
        System.out.println("Variable eineZahl2: " + eineZahl2);
        System.out.println("Konstante MAX_WERT: " + MAX_WERT);
        System.out.println("Variable grosseZahl: " + grosseZahl);
    }
}
