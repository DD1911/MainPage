#Zufallszahlen

from random import randint

#randint()
#Gibt eine zufällige Zahl zwischen a und b wieder.
#In den Klammern nur schreiben: 1,6
#das a: und b: wird von pycharm ergänzt.
wuerfel = randint(1, 6)                 #z.B. 4

print(wuerfel)

zahl1 = randint(23, 24)
if zahl1 == 23:
    print('Super, Zahl1 ist 23!')

