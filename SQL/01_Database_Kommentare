-- ======================================
-- 1. Datenbank "exkurse" und Tabelle "zeiten" erstellen
-- ======================================
DROP DATABASE IF EXISTS exkurse;
CREATE DATABASE exkurse;
USE exkurse;

CREATE TABLE zeiten (
    id INT PRIMARY KEY,
    uhrzeit TIME,        -- Nur Uhrzeit (hh:mm:ss)
    datum DATE,          -- Nur Datum (yyyy-mm-dd)
    zeitpunkt DATETIME,  -- Kombination aus Datum & Uhrzeit
    jahr YEAR            -- Nur das Jahr
);

SHOW COLUMNS FROM zeiten;

-- ======================================
-- 2. Daten einfügen (ISO 8601 Format)
-- ======================================
INSERT INTO zeiten VALUES
(1, '13:49:33', '2025-07-15', '2025-07-15 13:49:33', '2025');

SELECT * FROM zeiten;

-- ======================================
-- 3. MySQL Funktionen für Datum & Zeit
-- ======================================
SELECT CURTIME();  -- aktuelle Uhrzeit
SELECT CURDATE();  -- aktuelles Datum
SELECT NOW();      -- aktueller Zeitpunkt (Datum + Uhrzeit)

SELECT YEAR('2025-07-15');           -- 2025
SELECT YEAR('2025-07-15 14:33:44');  -- 2025
SELECT YEAR(NOW());                  -- aktuelles Jahr

-- Einfügen aktueller Zeitangaben
INSERT INTO zeiten VALUES (2, CURTIME(), CURDATE(), NOW(), YEAR(NOW()));
SELECT * FROM zeiten;

-- ======================================
-- 4. Wochentage und Datumsberechnungen
-- ======================================
SELECT WEEKDAY(NOW());  -- Montag=0, Sonntag=6

SELECT DATEDIFF('2000-03-01', '2000-02-28');   -- 2 Tage
SELECT DATEDIFF('2001-03-01', '2001-02-28');   -- 1 Tag
SELECT DATEDIFF(CURDATE(), '1970-12-03');      -- Differenz zum aktuellen Datum

SELECT ADDDATE('1970-12-03', 10000);           -- 10000 Tage addieren
SELECT ADDDATE('1970-12-03', 20000);           -- 20000 Tage addieren

SELECT WEEKDAY(ADDDATE('1970-12-03', 20000));  -- Wochentag als Zahl
SELECT DAYNAME(ADDDATE('1970-12-03', 20000));  -- Wochentag als Name

SELECT WEEKDAY(ADDDATE('1970-12-03', 20000)),
       DAYNAME(ADDDATE('1970-12-03', 20000));  -- mehrere Werte

-- ======================================
-- 5. CONCAT() – Zeichenketten verbinden
-- ======================================
SELECT CONCAT(4, ' - ', 'Friday');  
SELECT CONCAT(WEEKDAY(ADDDATE('1970-12-03', 20000)), ' - ', DAYNAME(ADDDATE('1970-12-03', 20000)));

SELECT CONCAT(
    WEEKDAY(ADDDATE('1970-12-03', 20000)), 
    ' - ', 
    DAYNAME(ADDDATE('1970-12-03', 20000))
) AS 'Wochentag';

-- ======================================
-- 6. Tabelle "t1" und NULL-Werte
-- ======================================
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    wert INT       -- Spalte, die NULL enthalten kann
);

SHOW COLUMNS FROM t1;

INSERT INTO t1 VALUES
(1, 42),
(2, NULL);

SELECT * FROM t1;

-- ======================================
-- 7. Vergleichsoperatoren und NULL
-- ======================================
SELECT TRUE = TRUE;   -- 1 (True)
SELECT 23 = 42;       -- 0 (False)

SELECT NULL = NULL;   -- NULL
SELECT 17 = NULL;     -- NULL

SELECT * FROM t1 WHERE wert = NULL;       -- leer
SELECT * FROM t1 WHERE wert != NULL;      -- leer
SELECT * FROM t1 WHERE wert = 42;         -- id 1

-- ======================================
-- 8. IS NULL / IS NOT NULL
-- ======================================
SELECT * FROM t1 WHERE wert IS NULL;      -- id 2
SELECT * FROM t1 WHERE wert IS NOT NULL;  -- id 1
SELECT * FROM t1 WHERE NOT wert IS NULL;  -- id 1 (identisch)
