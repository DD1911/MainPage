-- ======================================
-- n:m-Beziehung: Filme & Schauspieler
-- ======================================

-- Szenario:
-- - Ein Film hat VIELE Schauspieler:innen
-- - Ein:e Schauspieler:in spielt in VIELEN Filmen mit
-- => n:m-Beziehung
-- Lösung: Zwischentabelle (Join Table / Junction Table)

DROP DATABASE IF EXISTS filmverwaltung;
CREATE DATABASE filmverwaltung;
USE filmverwaltung;

-- ======================================
-- Tabelle "filme" erstellen
-- ======================================
CREATE TABLE filme (
    id INT PRIMARY KEY,
    titel VARCHAR(255),
    jahr YEAR
);

SHOW COLUMNS FROM filme;

-- ======================================
-- Tabelle "schauspieler" erstellen
-- ======================================
CREATE TABLE schauspieler (
    id INT PRIMARY KEY,
    vorname VARCHAR(255),
    nachname VARCHAR(255)
);

SHOW COLUMNS FROM schauspieler;

