-- ======================================
-- Zwischentabelle: Filme ↔ Schauspieler
-- ======================================
-- Löst die n:m-Beziehung auf
-- Benennung: "tabelle1_tabelle2"
CREATE TABLE filme_schauspieler (
    id INT PRIMARY KEY AUTO_INCREMENT,
    filme_id INT,        -- FK auf filme.id
    schauspieler_id INT  -- FK auf schauspieler.id
);

