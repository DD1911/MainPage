SELECT * FROM filme_schauspieler;  -- 22 rows
SELECT * FROM filme;               -- 10 rows
SELECT * FROM schauspieler;        -- 17 rows

-- ======================================
-- Beispiel-Abfragen
-- ======================================

-- 1) Alle Zuordnungen mit Filmtitel
SELECT *
FROM filme_schauspieler
INNER JOIN filme ON filme_id = filme.id;

-- 2) Alle Zuordnungen mit Schauspielername & Filmtitel
SELECT *
FROM filme_schauspieler
INNER JOIN filme ON filme_id = filme.id
INNER JOIN schauspieler ON schauspieler_id = schauspieler.id;

-- 3) Nur Vorname, Nachname, Titel
SELECT vorname,
       nachname,
       titel
FROM filme_schauspieler
INNER JOIN filme ON filme_id = filme.id
INNER JOIN schauspieler ON schauspieler_id = schauspieler.id;

-- ======================================
-- Hinweis:
-- Die Zwischentabelle ermöglicht beliebig viele Schauspieler pro Film
-- und beliebig viele Filme pro Schauspieler.
-- Dadurch ist die n:m-Beziehung korrekt abgebildet.
