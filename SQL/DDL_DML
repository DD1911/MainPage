-- ======================================
-- TABELLE "staedte"
-- ======================================
-- Als nächstes brauche ich eine Tabelle für Städte.
-- Jede Stadt gehört zu einem Land (1:n-Beziehung).
CREATE TABLE staedte (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL,
    einwohnerzahl INT,
    laender_id INT,
    -- laender_id ist mein Fremdschlüssel und zeigt auf die Tabelle laender
    FOREIGN KEY (laender_id) REFERENCES laender(id)
);

