-- ======================================
-- MEINE DATENBANK "ERDKUNDE"
-- ======================================

-- Ich lösche die Datenbank, falls sie schon existiert.
-- Das ist praktisch, damit ich das Skript immer wieder von vorne ausführen kann,
-- ohne dass ich Fehlermeldungen bekomme.
DROP DATABASE IF EXISTS erdkunde;

-- Jetzt lege ich die Datenbank neu an.
CREATE DATABASE erdkunde;

-- Zur Kontrolle schaue ich mir an, welche Datenbanken es aktuell gibt.
SHOW DATABASES;

-- Ich wechsle in meine neue Datenbank, sonst würden die Tabellen woanders angelegt werden.
USE erdkunde;

-- ======================================
-- TABELLE "laender"
-- ======================================
-- Ich brauche eine Tabelle für Länder.
-- Sie bekommt eine ID, einen Namen und die Einwohnerzahl.
CREATE TABLE laender (
    id INT PRIMARY KEY AUTO_INCREMENT,
    -- id ist mein Primärschlüssel = eindeutige Nummer pro Land
    -- AUTO_INCREMENT bedeutet, dass MySQL die Zahl automatisch hochzählt
    name VARCHAR(255) NOT NULL,
    -- name = Name des Landes, darf nicht leer sein (NOT NULL)
    einwohnerzahl INT
    -- Anzahl der Einwohner (ganzzahliger Wert)
);

-- Mal schauen, wie die Tabelle aufgebaut ist:
SHOW COLUMNS FROM laender;

