-- ======================================
-- ERKLÄRUNG DER BEZIEHUNG
-- ======================================
-- So habe ich die 1:n-Beziehung aufgebaut:
--   - Eine Stadt gehört GENAU zu einem Land (z. B. Berlin -> Deutschland).
--   - Ein Land kann VIELE Städte enthalten (z. B. Deutschland -> Berlin, Hamburg, München).
-- Das Ganze funktioniert über den Fremdschlüssel laender_id in der Tabelle staedte.

-- ======================================
-- BEISPIELE (meine Testabfragen)
-- ======================================

-- 1. Alle Städte mit dem passenden Land anzeigen
SELECT s.name AS stadt, s.einwohnerzahl, l.name AS land
FROM staedte s
JOIN laender l ON s.laender_id = l.id;

-- 2. Einwohner aller Städte pro Land summieren
SELECT l.name AS land, SUM(s.einwohnerzahl) AS gesamt_einwohner_staedte
FROM laender l
JOIN staedte s ON s.laender_id = l.id
GROUP BY l.name;

-- 3. Top-3 Städte nach Einwohnerzahl über alle Länder
SELECT name, einwohnerzahl
FROM staedte
ORDER BY einwohnerzahl DESC
LIMIT 3;

-- 4. Spezielles Beispiel: Alle Städte in Deutschland anzeigen
-- Ich verknüpfe staedte mit laender und filtere nach dem Land "Deutschland".
SELECT s.name AS deutsche_stadt, s.einwohnerzahl
FROM staedte s
JOIN laender l ON s.laender_id = l.id
WHERE l.name = 'Deutschland';
