USE erdkunde;

-- ======================================
-- DELETE = Datensätze löschen
-- ======================================
-- DELETE gehört zur DML (Data Manipulation Language)
-- Syntax: DELETE FROM tabelle WHERE bedingung;

-- ======================================
-- 1. Einzelne Zeile löschen
-- ======================================
-- Beispiel: Die Stadt Rom löschen
SELECT * FROM staedte WHERE name = 'Rom';  -- Kontrolle vorher
DELETE FROM staedte WHERE name = 'Rom';
SELECT * FROM staedte;  -- Kontrolle nachher, 17 Zeilen

-- ======================================
-- 2. Mehrere Zeilen löschen mit BETWEEN
-- ======================================
-- Beispiel: Städte mit ID zwischen 9 und 12 löschen
DELETE FROM staedte WHERE id BETWEEN 9 AND 12;
SELECT * FROM staedte;  -- Kontrolle, jetzt 13 Zeilen

-- Hinweis: MySQL zeigt an, wie viele Datensätze gelöscht wurden
-- Wenn kein Datensatz gelöscht wird, gibt es keinen Fehler, sondern "0 rows affected"

-- ======================================
-- 3. Alle Datensätze löschen
-- ======================================
-- ACHTUNG: Ohne WHERE löscht man ALLE Zeilen!
DELETE FROM staedte;
SELECT * FROM staedte;  -- Kontrolle, jetzt 0 Zeilen

USE erdkunde;

-- ======================================
-- 4. DELETE = einzelne oder alle Datensätze löschen
-- ======================================
DELETE FROM staedte;            -- Alle Datensätze löschen
SELECT * FROM staedte;          -- Kontrolle: 0 Zeilen
-- Hinweis: AUTO_INCREMENT wird NICHT zurückgesetzt
-- Neue Inserts erhalten weiterhin die nächste ID
INSERT INTO staedte (name, einwohnerzahl) VALUES ('Friesoythe', 27000);
SELECT * FROM staedte;          -- id = 19 (nicht 1!)

-- ======================================
-- 5. TRUNCATE = ganze Tabelle leeren
-- ======================================
-- Gehört zur DDL (Data Definition Language), nicht DML
-- Setzt auch den AUTO_INCREMENT zurück
TRUNCATE TABLE staedte;
INSERT INTO staedte (name, einwohnerzahl) VALUES ('Friesoythe', 27000);
SELECT * FROM staedte;          -- id = 1

-- ======================================
-- 6. Zusammenfassung: DDL vs DML
-- ======================================
-- DDL (Data Definition Language) → Struktur ändern:
--   CREATE TABLE, DROP TABLE, ALTER TABLE, TRUNCATE
--   -> TRUNCATE gehört zur DDL, daher wird AUTO_INCREMENT zurückgesetzt

-- DML (Data Manipulation Language) → Daten ändern:
--   SELECT, INSERT, UPDATE, DELETE
--   -> DELETE löscht nur die Daten, AUTO_INCREMENT bleibt bestehen

-- Faustregel:
--   DROP = ganze Struktur entfernen
--   DELETE = nur Daten löschen
--   TRUNCATE = alle Daten löschen + AUTO_INCREMENT zurücksetzen
