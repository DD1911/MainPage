USE erdkunde;

-- ======================================
-- LÖSCHEN VON DATENSÄTZEN UND TABELLEN
-- ======================================

-- DELETE = einzelne oder mehrere Datenzeilen löschen
-- TRUNCATE = alle Daten löschen + AUTO_INCREMENT zurücksetzen
-- DROP TABLE = ganze Tabelle inkl. Struktur löschen
-- DROP DATABASE = gesamte Datenbank inkl. Tabellen löschen

-- --------------------------------------
-- 0. Vorbereitungen: alte Tabellen entfernen
-- --------------------------------------
DROP TABLE IF EXISTS staedte;
DROP TABLE IF EXISTS laender;

-- --------------------------------------
-- 1. Einzelne Zeile löschen (DELETE)
-- --------------------------------------
-- Beispiel: Die Stadt Rom löschen
SELECT * FROM staedte WHERE name = 'Rom';  -- Kontrolle vorher
DELETE FROM staedte WHERE name = 'Rom';
SELECT * FROM staedte;                     -- Kontrolle nachher

-- --------------------------------------
-- 2. Mehrere Zeilen löschen mit BETWEEN
-- --------------------------------------
DELETE FROM staedte WHERE id BETWEEN 9 AND 12;
SELECT * FROM staedte;                     -- Kontrolle

-- --------------------------------------
-- 3. Alle Datensätze löschen
-- --------------------------------------
DELETE FROM staedte;
SELECT * FROM staedte;                     -- Kontrolle

-- --------------------------------------
-- 4. DELETE vs. TRUNCATE
-- --------------------------------------
-- DELETE löscht nur Daten, AUTO_INCREMENT bleibt
INSERT INTO staedte (name, einwohnerzahl) VALUES ('Friesoythe', 27000);
SELECT * FROM staedte;                     -- id steigt weiter

-- TRUNCATE löscht Daten + setzt AUTO_INCREMENT zurück
TRUNCATE TABLE staedte;
INSERT INTO staedte (name, einwohnerzahl) VALUES ('Friesoythe', 27000);
SELECT * FROM staedte;                     -- id = 1

-- ======================================
-- 5. Alte Datenbank löschen, neue anlegen
-- ======================================
DROP DATABASE IF EXISTS erdkunde;          -- Ganze DB entfernen
CREATE DATABASE erdkunde;                  -- Neue DB anlegen
USE erdkunde;

-- ======================================
-- 6. Tabellen erstellen
-- ======================================
CREATE TABLE staedte
(
    id INT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    `name` VARCHAR(255),      -- Stadtname (NULL erlaubt)
    einwohnerzahl INT,        -- Einwohnerzahl (NULL erlaubt)
    laender_id INT            -- FK auf Länder-Tabelle (NULL erlaubt)
);

CREATE TABLE laender
(
    id INT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    `name` VARCHAR(255),      -- Ländername (NULL erlaubt)
    einwohnerzahl INT         -- Einwohnerzahl (NULL erlaubt)
);

