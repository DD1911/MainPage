#Runden

#round(zahl [,nachkommastellen])
#Python-eigene Funktion
#Ohne Angabe der Nachkommastellen wird auf 0 stellen sprich ganzzahl gerundet.
print(round(4.49))                  #4
print(round(4.849, 1))              #4.8
print(round(4.8249, 2))             #4.82
#Oldschool auf zwei Stellen runden:
print(round(4.8249 * 100) / 100)    #4.82

#Python rundet mathematisch.
#Bei *genau* .5 wird zur geraden Zahl gerundet.

print(round(0.5))                   #0
print(round(1.5))                   #2
print(round(2.5))                   #2
print(round(3.5))                   #4
print(round(4.5))                   #4

print(round(0.5000000001))          #1


import math

#Aufrunden
#math.ceil()
#Deutsch: Decke
print(math.ceil(9.1))               #10
print(math.ceil(-7.8))              #-7

#Abrunden
#math.floor()
#Deutsch: Boden
#Rundet weiter runter in der skala
print(math.floor(6.9))              #6
print(math.floor(-6.4))             #-7






