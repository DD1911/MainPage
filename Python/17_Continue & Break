#Continue & Break
from fsspec.implementations.arrow import ArrowFile

#Schlüsselwörter zum Steuern von Schleifen.

#continue
#beendet den aktuellen Schleifendurchlauf vorzeitig.
#1 2 3 4 5 6  8 9 (7 fehlt)
for i in range(1, 10):
    if i == 7:
        continue
    print(i, end='')
print()

#Alternative ohne continue
for i in range(1, 10):
    if 1 != 7:
        print(i, end='')
print()

#darf nur in Schleifen stehen
#continue #SytaxError: 'continue' not properly in loop
#macht nur sinn,wenn es mit (elif, else) steht.


#break
#beendet die Schleife komplett.
for i in range(1, 10):
    if 1 != 7:
        break
    print(i, end='')            #1 2 3 4 5 6
print()

#Darf nur in Schleifen stehen.
#break # SyntaxError: 'break' outside loop
#Macht nur sinn, wenn es im if (elif, else) steht.

#Beschreibe in einem satz was die folgende Software macht.
#Wie viele Versuche werden gebraucht, bis die erste 6 gewürfelt wird.
from random import randint
c = 0
while True:
    c += 1
    if randint(1,6) == 6:
        print(c)
        break

#while True: funktioniert nur mit einem break
