# Dictionaries durchlaufen

# Beim Iterieren eines Dictionaries bekommt man die Keys
person1 = {'vorname': 'Daniel', 'nachname': 'Dmitrovski', 'alter': 29}
print(list(person1))  # ['vorname', 'nachname', 'alter']

for key in person1:
    print(key, end=' ')  # vorname nachname alter
print()

# keys()-Methode
# Wird oft benutzt, um für den Menschen deutlich zu machen, dass die Keys iteriert werden.
person1 = {'vorname': 'Daniel', 'nachname': 'Dmitrovski', 'alter': 29}
print(person1.keys())  # dict_keys(['vorname', 'nachname', 'alter'])

for key in person1.keys():
    print(key, end=' ')  # vorname nachname alter
print()


# values()-Methode
for key in person1.values():
    print(key, end=' ')  #
print()

for key in person1.keys():
    print(key + ': ' + str(person1[key]))
        # vorname: Daniel
        # nachname: Dmitrovski
        # alter: 29









































