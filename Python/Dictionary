# Dictionary

# Verwandt mit der Liste
# Unterschied zur Liste ist, dass der Index/Key ein "beliebiger" Datentyp sein kann.
# Liste ist in PHP das nummerische Array.
# Dictionary ist in PHP assoziative Array.
# Bei der Liste spricht man vom Index und beim Dictionary vom Key.

# Ein Dictionary beinhaltet beliebig viele Schlüssel (key) / Wert (value) Paare.

# Ein Dictionary wird mit geschweiften Klammer (curly brackets) erzeugt.
person1 = {'vorname': 'Daniel', 'nachname': 'Dmitrovski', 'alter': 29}
print(person1)  # {'vorname': 'Daniel', 'nachname': 'Dmitrovski', 'alter': }

# Einzelne Werte auslesen, indem man den Key in ECKIGEN Klammern angibt.
print(person1['vorname'])   # Daniel
print(person1['nachname'])  # Dmitrovski
print(person1['alter'])     # 29
print(person1)              # {'vorname': 'Daniel', 'nachname': 'Dmitrovski', 'alter': 29}

# pop(key)
person1 = {'vorname': 'Daniel', 'nachname': 'Dmitrovski', 'alter':29}
vorname1 = person1.pop('vorname')
print(vorname1)  # Daniel
print(person1)   # {'nachname': 'Dmitrovski', 'alter': 29}

# Das Verändern eines Dictionarys läuft wie bei einer Liste:
person2 = {'vorname': 'Hans', 'nachname': 'Dmitrovski', 'alter':29}
print(person2)  # {'vorname': 'Daniel', 'nachname': 'Dmitrovski', 'alter': 29}
person2['vorname'] = 'Hans'
print(person2)  # {'vorname': 'Hans', 'nachname': 'Dmitrovski', 'alter': 29}

