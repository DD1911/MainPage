#if
#WENN die Bedingung True ist, frühe einen eingerückten Quellcode aus.
#Es kann auch nichts ausgeführt werden.
#zahl1 = 23             # das # wird gesetzt um es auszukomentieren und einen der beiden Zustände zu erzeugen.
zahl1 = 23
#zahl1 = 24
if zahl1 == 23:
    print('Super, zahl1 ist 23!')           #Super, zahl1 ist 23!


