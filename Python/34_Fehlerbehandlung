    # e3 = 'Hello' + 7            # TypeError
    # e4 = unbekannt              # NameError
    # def e5(): e5()              # RecursionError
    # e5()
    # e6 = open('unbekannt.txt')  # FileNotFoundError
    # e7 = [1, 2][2]              # IndexError
    e8 = {'vorname': 'Peter'}['nachname']

except BaseException as e:
    print(type(e))  # <class '...'>
    print(e)


# Fehlerbehandlung

# Validieren per Exceptions

while True:

    try:

        eingabe = input('Bitte eine Ganzzahl größer 0 eingeben!')

        zahl = int(eingabe)                                  # 'zweiundzwanzig' -> ValueError

        print('Das Ergebnis der Division ist:', 100 / zahl)  # 0 -> ZeroDivisionError

    except ValueError:
        print('Die Eingabe war keine Ganzzahl!')
    except ZeroDivisionError:
        print('Die Eingabe war 0!')
    else:
        break

print('Programmstart:')
print(zahl)






