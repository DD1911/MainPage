print(int('22'))
# print(int('zweiundzwanzig'))  # ValueError

# Die wichtigsten Schlüsselwörter sind try & except

# try - probiere (aus)
# except - außer

# In den try-Block schreibt man das, was schiefgehen könnte (was man ausprobieren möchte).
# In quasi allen anderen Sprachen heisst es catch statt except.
# Wenn im try-Block ein Fehler entsteht/geworfen wird,
# wird dieser vom except-Block aufgefangen.
try:

    print(int('22'))
    print(int('zweiundzwanzig'))

except:

    print('Die Eingabe war keine Ganzzahl!')


print('Hauptprogrammteil')

# Fehlerbehandlung

# Fehlernamen.
# Wenn neben dem except ein Fehlername steht, geht nur diese Fehlerart in diesen except-Block.

try:

    print(int('zweiundzwanzig'))                       # ValueError
    eingabe = '0'
    zahl = int(eingabe)
    print('Das Ergebnis der Division ist:', 100 / zahl)  # ZeroDivisionError

except ValueError:
    print('Die Eingabe war keine Ganzzahl!')
except ZeroDivisionError:
    print('Die Eingabe war 0!')


# ZeroDivisionError.
# Nirgendwo (Mathematik und keiner Programmiersprache) darf man durch 0 teilen.
# print(100 / 0)  # ZeroDivisionError: division by zero

# Die Fehlerklassen sind in der UpperCamelCase-Schreibweise

# Fehlerbehandlung

# else
# Wird ausgeführt, wenn kein except-Block ausgeführt wird.

try:

    eingabe = '7'
    zahl = int(eingabe)
    print('Das Ergebnis der Division ist:', 100 / zahl)

    # Alternativer else-Bereich
    #

    print('Alles war gut! (Alternativer Bereich)')

except ValueError:
    print('Die Eingabe war keine Ganzzahl!')
except ZeroDivisionError:
    print('Die Eingabe war 0!')
else:
    print('Alles war gut! (else)')


# Fehlerbehandlung

# finally
# Wird in jedem Fall ausgeführt.

try:

    eingabe = '7'
    zahl = int(eingabe)
    print('Das Ergebnis der Division ist:', 100 / zahl)

    # Alternativer else-Bereich
    # Bereich, der nur erreicht wird, wenn kein Fehler geworfen wird.
    print('Alles war gut! (Alternativer Bereich)')

except ValueError:
    print('Die Eingabe war keine Ganzzahl!')
except ZeroDivisionError:
    print('Die Eingabe war 0!')
else:
    print('Alles war gut! (else)')
finally:
    print('Hier werden z.B. Datenbank-Verbindungen geschlossen.')

print('Weiter im Skript.')



