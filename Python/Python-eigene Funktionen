 Python-eigene Funktionen

# len()
# Gibt die Anzahl der Elemente (Länge) einer sequenz zurück.
print(len([1, 3, 5, 7]))                        #4
print(len('Hello World'))                       #11
print(len(range(0, 1001, 44)))                  #23
print(list(range(0, 1001, 44)))                 #23 Elemente in der Sequenz

# min()
# Gibt den kleinsten Wert einer Sequenz zurück.
print(min([6, 4, 2, 9, 11, 13]))  # 2
# Bei Strings geht es um die Größe des ASCII-Zahlenwerts der einzelnen Zeichen.
# https://www.chip.de/ii/1/0/9/3/0/3/2/4/4/b1a76775417075b1.png
print(min('Hello'))  # H
print(min('HALLO'))  # A

# max()
# Gibt den größten Wert einer Sequenz zurück.
print(max([6, 4, 2, 9, 11, 13]))  # 13

